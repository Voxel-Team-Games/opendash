#!/bin/bash

# Caminhos baseados na estrutura do seu projeto
PCSX2_BIN="./pcsx2"
SRC_DIR="./playstation2"
BUILD_DIR="./playstation2build"
ISO_PATH="${BUILD_DIR}/build.iso"
XML_TEMP="${BUILD_DIR}/project.xml"

# Cabeçalho padrão do script
show_header() {
    echo "PlayBuild======================================"
    echo "Playstation ISO Builder"
    echo "============================================="
}

# Função interna para gerar o XML e compilar com o mkps2iso
build_iso() {
    echo "Building ISO from ./playstation2/ folder files..."
    
    # 1. Localiza o primeiro arquivo .elf na pasta de origem
    ELF_FILE=$(ls "${SRC_DIR}"/*.elf 2>/dev/null | head -n 1)
    ELF_NAME=$(basename "${ELF_FILE}")
    
    if [ -z "${ELF_NAME}" ]; then
        echo "Error: No .elf file found in ${SRC_DIR}/ folder!"
        exit 1
    fi
    
    # 2. Verifica se o mkps2iso está instalado no sistema
    if ! command -v mkps2iso >/dev/null 2>&1; then
        echo "Error: O comando 'mkps2iso' não foi encontrado no sistema."
        exit 1
    fi
    
    # 3. Garante que a pasta de destino do build exista
    mkdir -p "${BUILD_DIR}"
    
    # 4. GERAÇÃO DO SYSTEM.CNF na pasta de origem (se não existir)
    if [ ! -f "${SRC_DIR}/SYSTEM.CNF" ] && [ ! -f "${SRC_DIR}/system.cnf" ]; then
        ELF_UPPER=$(echo "${ELF_NAME}" | tr '[:lower:]' '[:upper:]')
        cat <<EOF > "${SRC_DIR}/SYSTEM.CNF"
BOOT2 = cdrom0:\\${ELF_UPPER};1
VER = 1.00
VMODE = NTSC
EOF
    fi

    # Remove o arquivo ISO antigo para evitar conflitos ou prompts interativos
    rm -f "${ISO_PATH}"

    # Obtém o caminho absoluto necessário para mapear arquivos locais no XML
    ABS_SRC_DIR=$(cd "${SRC_DIR}" && pwd)

    # 5. MONTAGEM DINÂMICA DO XML (Declaração explícita de arquivos para o mkps2iso)
    # Escreve o cabeçalho inicial do projeto XML
    cat <<EOF > "${XML_TEMP}"
<iso_project description="PlayBuild Auto Generated Project">
    <volume id="PLAYBUILD" timezone="0"/>
    <layer>
        <directory_tree>
EOF

    # Varre a pasta fisicamente e injeta cada arquivo individualmente usando caminhos absolutos
    # O mkps2iso exige o nome real na ISO (name) e a origem física (source)
    for filename in $(ls "${SRC_DIR}"); do
        # Pula diretórios caso existam (focado apenas em arquivos na raiz do game)
        if [ -f "${SRC_DIR}/${filename}" ]; then
            echo "            <file name=\"${filename}\" source=\"${ABS_SRC_DIR}/${filename}\"/>" >> "${XML_TEMP}"
        fi
    done

    # Fecha as tags do projeto XML
    cat <<EOF >> "${XML_TEMP}"
        </directory_tree>
    </layer>
</iso_project>
EOF

    # 6. Executa o mkps2iso
    mkps2iso -o "${ISO_PATH}" "${XML_TEMP}"
    
    # 7. Validação física do arquivo final gerado
    if [ ! -f "${ISO_PATH}" ]; then
        echo "Error: Dynamic compilation failed. ISO file was not generated."
        rm -f "${XML_TEMP}"
        exit 1
    fi
    
    # Remove o XML temporário após o processo acabar
    rm -f "${XML_TEMP}"
    
    echo "Builded ISO at ${ISO_PATH}!"
}

# Estrutura de decisão baseada no argumento ($1)
case "$1" in
    "build")
        show_header
        build_iso
        ;;
        
    "run")
        show_header
        build_iso
        echo "Running ISO with PCSX2..."
        
        # Verifica se o arquivo binário do PCSX2 existe e é executável
        if [ -x "${PCSX2_BIN}" ]; then
            # Logs mantidos abertos para depuração da BIOS/Engine se necessário
            "${PCSX2_BIN}" "${ISO_PATH}"
        else
            echo "Error: Executável do PCSX2 não encontrado em ${PCSX2_BIN}"
            exit 1
        fi
        
        echo "Process Ended!"
        ;;
        
    *)
        show_header
        echo "None argument was detected, exiting..."
        exit 1
        ;;
esac
